# Bootstrap only: saved Engine settings take precedence after restart.
# Use only the exact frontend origins actually needed. This example is the
# plan's optional same-site, local-bundle browser test origin, not UI hosting.
KLM_ALLOWED_ORIGINS=https://klm-playwright.codemob.com.br

# ONLY for a verified host-local TLS-terminating proxy connecting over IPv4.
# Replace with the actual immediate TLS proxy's narrowly scoped IP CIDR(s).
# Do not trust arbitrary Docker networks, Cloudflare ranges, or 0.0.0.0/0.
KLM_TRUSTED_TLS_PROXIES=127.0.0.1/32

# KLM_API_BIND_HOST=127.0.0.1 is set in klm.service before the first listen.
# Do not override it with a public bind or enable a development auth bypass.
